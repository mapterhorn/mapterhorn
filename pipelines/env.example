# Copy to .env (gitignored) or `source` this file before running the pipeline.
# All heavy data then lives outside the git checkout — no in-repo symlinks needed.

# Base directory for every store (source-store, aggregation-store, tmp-store, ...)
export MAPTERHORN_DATA_ROOT=/mnt/ssd/mapterhorn

# Optional: put large sequential stores on HDD while keeping the rest on SSD
# export MAPTERHORN_PMTILES_STORE=/mnt/hdd/mapterhorn/pmtiles-store
# export MAPTERHORN_BUNDLE_STORE=/mnt/hdd/mapterhorn/bundle-store
# export MAPTERHORN_TAR_STORE=/mnt/hdd/mapterhorn/tar-store

# Optional: symlink sources into tmp instead of copying (saves SSD space)
# export MAPTERHORN_SOFTLINK_SOURCE=1

# export MAPTERHORN_NUM_WORKERS=32
# export MAPTERHORN_MAX_TMP_SOURCE_SIZE=100
# export MAPTERHORN_MIN_FREE_GB=50
