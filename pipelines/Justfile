# Operator recipes for the Mapterhorn bathymetry-aware pipeline.
# Run from the pipelines/ directory.
# Loads pipelines/.env if present (copy from env.example).
set dotenv-load := true

# Show high-level progress
status:
    uv run python status.py

# Dependency / data readiness checks
preflight:
    uv run python preflight.py

# Build shoreline land/ocean mask (required before aggregation with bathymetry)
shoreline:
    uv run python source_prepare_shoreline.py

# Prepare selected sources (override with just sources SOURCES="gebco emodnet")
SOURCES := "gebco"
sources:
    #!/usr/bin/env bash
    set -euo pipefail
    for s in {{SOURCES}}; do
      echo "=== preparing $s ==="
      just ../source-catalog/$s/
    done

# Clear / load / reload source data
#   just manage list
#   just manage autodownload -y
#   just manage autodownload gebco emodnet -y
#   just manage clear gebco -y
#   just manage reload gebco -y
#   just manage reload --ocean -y
manage *ARGS:
    uv run python source_manage.py {{ARGS}}

# Show which disk each store directory resolves to
storage:
    uv run python storage_layout.py

covering:
    uv run python aggregation_covering.py
    uv run python downsampling_covering.py

# Stage source files for aggregation (run in a separate terminal during aggregate)
downloader:
    uv run python downloader.py

aggregate:
    uv run python aggregation_run.py

downsample:
    uv run python downsampling_run.py

bundle VERSION="1":
    uv run python remove_dangling_pmtiles.py
    TMPDIR=/tmp uv run python bundle.py {{VERSION}}
    uv run python download_urls.py {{VERSION}}
    uv run python attribution.py

retry-failed:
    uv run python retry_failed.py

# Full resumable sequence (expects sources + shoreline already prepared)
all VERSION="1":
    #!/usr/bin/env bash
    set -euo pipefail
    uv run python preflight.py
    uv run python aggregation_covering.py
    uv run python downsampling_covering.py
    # Start downloader in background for this session
    uv run python downloader.py &
    DL_PID=$!
    trap 'kill $DL_PID 2>/dev/null || true' EXIT
    uv run python aggregation_run.py
    uv run python downsampling_run.py
    uv run python remove_dangling_pmtiles.py
    TMPDIR=/tmp uv run python bundle.py {{VERSION}}
    uv run python download_urls.py {{VERSION}}
    uv run python attribution.py
    uv run python status.py

upload:
    uv run python upload.py

# Default: print help
default:
    @echo "Run from pipelines/. Two phases: get data, then build tiles."
    @echo ""
    @echo "1) Get data (once, resumable):"
    @echo "     just storage"
    @echo "     just manage autodownload -y      # download + prep all sources + shoreline"
    @echo "     just manage list                 # DL=yes means that source is safe to use"
    @echo ""
    @echo "2) Build tiles:"
    @echo "     just covering                    # plan which tiles to make"
    @echo "     just downloader                  # terminal A: copy rasters into tmp-store"
    @echo "     just aggregate                   # terminal B: merge sources into tiles"
    @echo "     just downsample"
    @echo "     just bundle VERSION=1"
    @echo ""
    @echo "Or after data is ready:  just all VERSION=1"
    @echo "  (covering + downloader + aggregate + downsample + bundle; does NOT download)"
    @echo ""
    @echo "Watch / recover:"
    @echo "     just status          just retry-failed          just preflight"
    @echo ""
    @echo "Same job, different names (usually skip these):"
    @echo "     just shoreline              = shoreline step of autodownload"
    @echo "     just sources SOURCES='x y'  = just manage load x y"
    @echo "     just manage load NAME       = autodownload one named source"
    @echo "     just manage reload NAME -y  = delete that source, then download again"
    @echo "     just manage clear NAME -y   = delete only"
    @echo "     just upload                 = push finished PMTiles (after bundle)"
