# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py atsalzburg
    pixi run --script source_set_crs.py atsalzburg EPSG:31258
    pixi run --script source_bounds.py atsalzburg
    pixi run --script source_polygonize.py atsalzburg 32
    pixi run --script source_create_tarball.py atsalzburg