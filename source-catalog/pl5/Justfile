# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py pl5
    pixi run --script source_to_cog.py pl5 # remove zip files, remove wrongly tagged 1m files
    pixi run --script source_set_crs.py pl5 EPSG:2180
    pixi run --script source_bounds.py pl5
    pixi run --script source_polygonize.py pl5 32
    pixi run --script source_create_tarball.py pl5
