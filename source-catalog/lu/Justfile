# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py lu
    pixi run --script source_unzip.py lu
    rm source-store/lu/MNT_Z3_Z4_Luref_NGL.tif # this file has a different resolution
    pixi run --script source_bounds.py lu
    pixi run --script source_polygonize.py lu 32
    pixi run --script source_create_tarball.py lu
    