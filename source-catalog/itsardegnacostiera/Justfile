# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py itsardegnacostiera
    pixi run --script source_unzip.py itsardegnacostiera
    pixi run --script source_set_crs.py itsardegnacostiera EPSG:25832
    pixi run --script source_bounds.py itsardegnacostiera
    pixi run --script source_polygonize.py itsardegnacostiera 32
    pixi run --script source_create_tarball.py itsardegnacostiera