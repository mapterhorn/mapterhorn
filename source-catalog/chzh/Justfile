# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py chzh
    pixi run --script source_to_cog.py chzh
    pixi run --script source_bounds.py chzh
    pixi run --script source_polygonize.py chzh 32
    pixi run --script source_create_tarball.py chzh
