# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py pl1
    pixi run --script source_to_cog.py pl1 # remove zip files
    pixi run --script source_set_crs.py pl1 EPSG:2180
    pixi run --script source_bounds.py pl1
    pixi run --script source_polygonize.py pl1 32
    pixi run --script source_create_tarball.py pl1