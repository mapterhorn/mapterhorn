# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py frrgealti1corse
    pixi run --script source_unzip.py frrgealti1corse # translate only the .asc files
    pixi run --script source_set_crs.py frrgealti1corse EPSG:2154
    pixi run --script source_bounds.py frrgealti1corse
    pixi run --script source_polygonize.py frrgealti1corse 32
    pixi run --script source_create_tarball.py frrgealti1corse
