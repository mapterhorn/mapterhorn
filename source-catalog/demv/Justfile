# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py demv # rename demv files by hand
    pixi run --script source_set_nodata.py demv -9999
    pixi run --script source_bounds.py demv
    pixi run --script source_polygonize.py demv 32
    pixi run --script source_create_tarball.py demv