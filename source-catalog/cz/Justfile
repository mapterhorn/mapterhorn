# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py cz
    pixi run --script source_unzip.py cz
    pixi run --script source_bounds.py cz
    pixi run --script source_polygonize.py cz 32
    pixi run --script source_create_tarball.py cz
