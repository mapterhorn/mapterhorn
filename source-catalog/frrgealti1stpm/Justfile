# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py frrgealti1stpm
    pixi run --script source_unzip.py frrgealti1stpm # translate only the .asc files
    pixi run --script source_set_crs.py frrgealti1stpm EPSG:4467
    pixi run --script source_bounds.py frrgealti1stpm
    pixi run --script source_polygonize.py frrgealti1stpm 32
    pixi run --script source_create_tarball.py frrgealti1stpm