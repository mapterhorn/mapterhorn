# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py nz
    pixi run --script source_to_cog.py nz
    pixi run --script source_bounds.py nz
    pixi run --script source_polygonize.py nz 32
    pixi run --script source_create_tarball.py nz