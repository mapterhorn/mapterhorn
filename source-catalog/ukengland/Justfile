# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    rm source-store/ukengland/*.tfw
    rm source-store/ukengland/*.xml
    rm source-store/ukengland/*.ovr
    pixi run --script source_to_cog.py ukengland
    pixi run --script source_bounds.py ukengland
    pixi run --script source_polygonize.py ukengland 32
    pixi run --script source_create_tarball.py ukengland