# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py frrgealti1caribbean
    pixi run --script source_unzip.py frrgealti1caribbean # translate only the .asc files
    pixi run --script source_set_crs.py frrgealti1caribbean EPSG:4559
    pixi run --script source_bounds.py frrgealti1caribbean
    pixi run --script source_polygonize.py frrgealti1caribbean 32
    pixi run --script source_create_tarball.py frrgealti1caribbean