# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py cy
    rm source-store/cy/ETRS89_2000_3250.tif # this is a 1x1 pixel sized file
    pixi run --script source_to_cog.py cy
    pixi run --script source_bounds.py cy
    pixi run --script source_polygonize.py cy 32
    pixi run --script source_create_tarball.py cy