# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py dehamburg
    # unzip dehamburg unzip by hand, it has a nested zip file
    pixi run --script source_to_cog.py dehamburg
    pixi run --script source_set_crs.py dehamburg EPSG:25832
    pixi run --script source_set_nodata.py dehamburg 0.0
    pixi run --script source_fix_orientation.py dehamburg
    pixi run --script source_bounds.py dehamburg
    pixi run --script source_polygonize.py dehamburg 32
    pixi run --script source_create_tarball.py dehamburg