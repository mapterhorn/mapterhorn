# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py deberlin
    pixi run --script source_unzip.py deberlin
    pixi run --script source_set_crs.py deberlin EPSG:25833
    pixi run --script source_set_nodata.py deberlin -9999
    pixi run --script source_fix_orientation.py deberlin
    pixi run --script source_bounds.py deberlin
    pixi run --script source_polygonize.py deberlin 32
    pixi run --script source_create_tarball.py deberlin