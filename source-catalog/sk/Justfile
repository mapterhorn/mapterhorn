# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py sk
    pixi run --script source_unzip.py sk
    pixi run --script source_set_crs.py sk EPSG:5514
    pixi run --script source_slice.py sk 16384
    pixi run --script source_to_cog.py sk
    pixi run --script source_bounds.py sk
    pixi run --script source_polygonize.py sk 32
    pixi run --script source_create_tarball.py sk