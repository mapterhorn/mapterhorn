# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py ukwales
    pixi run --script source_slice.py ukwales 16384
    pixi run --script source_to_cog.py ukwales
    pixi run --script source_bounds.py ukwales
    pixi run --script source_polygonize.py ukwales 32
    pixi run --script source_create_tarball.py ukwales
    