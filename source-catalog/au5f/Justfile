# Source preparation pipeline to be run from mapterhorn/pipelines folder

[no-cd]
default:
    pixi run --script source_download.py au5f
    pixi run --script source_unzip.py au5f
    pixi run --script source_bounds.py au5f
    pixi run --script source_polygonize.py au5f 32
    pixi run --script source_create_tarball.py au5f
