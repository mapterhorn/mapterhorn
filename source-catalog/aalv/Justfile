# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py aalv
    pixi run --script source_unzip.py aalv # sparse txt file, convert to tif by filling a matrix
    pixi run --script source_to_cog.py aalv
    pixi run --script source_bounds.py aalv
    pixi run --script source_polygonize.py aalv 32
    pixi run --script source_create_tarball.py aalv