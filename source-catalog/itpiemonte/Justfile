# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py itpiemonte
    pixi run --script source_unzip.py itpiemonte
    pixi run --script source_bounds.py itpiemonte
    pixi run --script source_polygonize.py itpiemonte 32
    pixi run --script source_create_tarball.py itpiemonte