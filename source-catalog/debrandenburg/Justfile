# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py debrandenburg
    pixi run --script source_unzip.py debrandenburg
    pixi run --script source_set_crs.py debrandenburg EPSG:25833
    pixi run --script source_bounds.py debrandenburg
    pixi run --script source_polygonize.py debrandenburg 32
    pixi run --script source_create_tarball.py debrandenburg