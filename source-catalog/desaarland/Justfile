# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py desaarland
    pixi run --script source_unzip.py desaarland
    pixi run --script source_bounds.py desaarland
    pixi run --script source_polygonize.py desaarland 32
    pixi run --script source_create_tarball.py desaarland