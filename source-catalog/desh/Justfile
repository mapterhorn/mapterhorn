# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py desh # rename files after download
    pixi run --script source_to_cog.py desh
    pixi run --script source_set_crs.py desh EPSG:25832
    pixi run --script source_set_nodata.py desh 0.0
    pixi run --script source_bounds.py desh
    pixi run --script source_polygonize.py desh 32
    pixi run --script source_create_tarball.py desh