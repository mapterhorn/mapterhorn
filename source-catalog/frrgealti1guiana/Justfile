# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py frrgealti1guiana
    pixi run --script source_unzip.py frrgealti1guiana # translate only the .asc files
    pixi run --script source_set_crs.py frrgealti1guiana EPSG:2972
    pixi run --script source_bounds.py frrgealti1guiana
    pixi run --script source_polygonize.py frrgealti1guiana 32
    pixi run --script source_create_tarball.py frrgealti1guiana