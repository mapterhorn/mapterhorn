# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py se
    pixi run --script source_to_cog.py se
    pixi run --script source_bounds.py se
    pixi run --script source_polygonize.py se 32 # fix compound CRS: ogr2ogr -f GPKG sefixed.gpkg se.gpkg -a_srs EPSG:3006
    pixi run --script source_create_tarball.py se

