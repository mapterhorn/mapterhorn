# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py desachsenanhalt
    pixi run --script source_unzip.py desachsenanhalt
    pixi run --script source_set_crs.py desachsenanhalt EPSG:25832
    pixi run --script source_bounds.py desachsenanhalt
    pixi run --script source_polygonize.py desachsenanhalt 32
    pixi run --script source_create_tarball.py desachsenanhalt