# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py itaosta
    pixi run --script source_unzip.py itaosta
    pixi run --script source_set_crs.py itaosta EPSG:23032
    pixi run --script source_bounds.py itaosta
    pixi run --script source_polygonize.py itaosta 32
    pixi run --script source_create_tarball.py itaosta