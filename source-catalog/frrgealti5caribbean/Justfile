# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py frrgealti5caribbean
    pixi run --script source_unzip.py frrgealti5caribbean
    pixi run --script source_set_crs.py frrgealti5caribbean EPSG:4559
    pixi run --script source_bounds.py frrgealti5caribbean
    pixi run --script source_polygonize.py frrgealti5caribbean 32
    pixi run --script source_create_tarball.py frrgealti5caribbean