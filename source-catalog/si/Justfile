# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py si
    pixi run --script source_to_cog.py si
    pixi run --script source_set_crs.py si EPSG:3794
    pixi run --script source_set_nodata.py si -9999
    pixi run --script source_fix_orientation.py si
    pixi run --script source_bounds.py si
    pixi run --script source_polygonize.py si 32
    pixi run --script source_create_tarball.py si