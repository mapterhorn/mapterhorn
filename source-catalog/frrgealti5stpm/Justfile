# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py frrgealti5stpm
    pixi run --script source_unzip.py frrgealti5stpm
    pixi run --script source_set_crs.py frrgealti5stpm EPSG:4467
    pixi run --script source_bounds.py frrgealti5stpm
    pixi run --script source_polygonize.py frrgealti5stpm 32
    pixi run --script source_create_tarball.py frrgealti5stpm