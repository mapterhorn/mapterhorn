# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py nlahn5lowresfilled
    # fill holes with gdal
    pixi run --script source_to_cog.py nlahn5lowresfilled
    pixi run --script source_bounds.py nlahn5lowresfilled
    pixi run --script source_polygonize.py nlahn5lowresfilled 32 # fix compound CRS: ogr2ogr -f GPKG nlahn5lowresfilledfixed.gpkg nlahn5lowresfilled.gpkg -a_srs EPSG:28992
    pixi run --script source_create_tarball.py nlahn5lowresfilled