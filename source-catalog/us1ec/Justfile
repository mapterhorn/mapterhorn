# Source preparation pipeline to be run from mapterhorn/pipelines folder

[no-cd]
default:
    pixi run --script source_download.py us1ec
    pixi run --script source_to_cog.py us1ec
    pixi run --script source_bounds.py us1ec
    pixi run --script source_polygonize.py us1ec 32
    pixi run --script source_create_tarball.py us1ec
