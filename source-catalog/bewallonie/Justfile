# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py bewallonie
    pixi run --script source_unzip.py bewallonie
    pixi run --script source_slice.py bewallonie 16384
    pixi run --script source_to_cog.py bewallonie
    pixi run --script source_bounds.py bewallonie
    pixi run --script source_polygonize.py bewallonie 32
    pixi run --script source_create_tarball.py bewallonie