# Source preparation pipeline to be run from mapterhorn/pipelines folder

[no-cd]
default:
    pixi run --script source_download.py au5g
    pixi run --script source_unzip.py au5g
    pixi run --script source_slice.py au5g 16384
    pixi run --script source_to_cog.py au5g
    pixi run --script source_bounds.py au5g
    pixi run --script source_polygonize.py au5g 32
    pixi run --script source_create_tarball.py au5g
