# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py tinitaly
    pixi run --script source_unzip.py tinitaly
    pixi run --script source_bounds.py tinitaly
    pixi run --script source_polygonize.py tinitaly 32
    pixi run --script source_create_tarball.py tinitaly