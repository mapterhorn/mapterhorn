# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py frrgealti1reunion
    pixi run --script source_unzip.py frrgealti1reunion # translate only the .asc files
    pixi run --script source_set_crs.py frrgealti1reunion EPSG:2975
    pixi run --script source_bounds.py frrgealti1reunion
    pixi run --script source_polygonize.py frrgealti1reunion 32
    pixi run --script source_create_tarball.py frrgealti1reunion