# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py frrgealti5reunion
    pixi run --script source_unzip.py frrgealti5reunion
    pixi run --script source_set_crs.py frrgealti5reunion EPSG:2975
    pixi run --script source_bounds.py frrgealti5reunion
    pixi run --script source_polygonize.py frrgealti5reunion 32
    pixi run --script source_create_tarball.py frrgealti5reunion