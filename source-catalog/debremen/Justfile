# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py debremen
    pixi run --script source_unzip.py debremen
    pixi run --script source_set_crs.py debremen EPSG:25832
    pixi run --script source_set_nodata.py debremen 0.0
    pixi run --script source_bounds.py debremen
    pixi run --script source_polygonize.py debremen 32
    pixi run --script source_create_tarball.py debremen