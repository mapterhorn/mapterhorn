# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    # no public download yet
    pixi run --script source_unzip.py itbozen
    pixi run --script source_set_nodata.py itbozen -9999
    pixi run --script source_bounds.py itbozen
    pixi run --script source_polygonize.py itbozen 32
    pixi run --script source_create_tarball.py itbozen