# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py ittrentino
    pixi run --script source_to_cog.py ittrentino
    pixi run --script source_bounds.py ittrentino
    pixi run --script source_polygonize.py ittrentino 32
    pixi run --script source_create_tarball.py ittrentino